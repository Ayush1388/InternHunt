# Knockd server settings. Copy to server/.env for local dev. Features switch on when their keys are set.

# Database: any Postgres with the pgvector extension (Neon, Supabase, RDS...).
# Leave empty locally to use the built-in PGlite database in server/data/pg.
DATABASE_URL=

# Public address of the site (for the Gmail redirect and Telegram webhook). Defaults to the Vercel URL.
PUBLIC_URL=

# Protects /api/cron/* and /api/admin/* (Vercel sends it to crons automatically when set).
CRON_SECRET=
# Encrypts stored Gmail tokens and signs OAuth state. Any long random string; keep it the same forever.
APP_SECRET=

# Google sign-in (web client id). Gmail drafts/sending also needs the client secret, with
# <PUBLIC_URL>/api/gmail/callback as an authorised redirect URI and the Gmail API enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini (paid tier for real users): email drafting + embeddings for matching.
# Without it, emails come from a careful template and matching uses skills only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# Telegram bot from @BotFather. After deploying, call POST /api/admin/telegram/setup once (with CRON_SECRET).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Optional: verified founder emails through the Apify email-finder actor (each run is capped in USD).
APIFY_TOKEN=
APIFY_MAX_CHARGE_USD=0.5

# Sending
DAILY_SEND_CAP=15

# Local dev
PORT=5000
DISABLE_AUTO_REFRESH=

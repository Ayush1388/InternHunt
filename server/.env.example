# Copy this file to server/.env and fill in what you need. Everything is optional.

# Port for the API (and the built app in production)
PORT=5000

# How often to re-fetch all boards, in hours
REFRESH_HOURS=6

# Drop company-page listings older than this many days (job boards: 30, HN: 40)
COMPANY_MAX_AGE_DAYS=120

# Set to 1 to stop the server refreshing on its own (you can still hit "Refresh now")
DISABLE_AUTO_REFRESH=0

# The Muse API key (optional, raises rate limits): https://www.themuse.com/developers/api/v2
MUSE_API_KEY=

# Hosted database (required on Vercel so data isn't lost). Create one free at https://turso.tech:
#   turso db create internhunt && turso db show internhunt --url && turso db tokens create internhunt
# Leave empty to use a local SQLite file in server/data/.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
